# Copy to .env and fill in. Never commit .env.

# Required
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# Tracing (Week 4, optional earlier)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=proofline

# Pipeline settings (defaults shown; all optional)
PROOFLINE_ENV=dev
PROOFLINE_BRAND_NAME=Build Clearly
PROOFLINE_MAX_WORDS=200
PROOFLINE_CHECKPOINTER_URL=sqlite:///.data/checkpoints.db
# PROOFLINE_CHECKPOINTER_URL=postgresql://postgres:<password>@<host>:5432/postgres   # Supabase
PROOFLINE_OUTPUT_DIR=outputs
PROOFLINE_SCORE_THRESHOLD=8.0
PROOFLINE_MAX_REVISIONS=3
PROOFLINE_MAX_SOURCES=8
PROOFLINE_RESULTS_PER_QUERY=5
PROOFLINE_MAX_SOURCE_CHARS=4000
PROOFLINE_PLANNER_MODEL=claude-haiku-5-5
PROOFLINE_RESEARCHER_MODEL=claude-haiku-5-5
PROOFLINE_WRITER_MODEL=claude-sonnet-5-5
PROOFLINE_CRITIC_MODEL=claude-sonnet-5-5
