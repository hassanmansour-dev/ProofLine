# Environment for a Measured Ops deployment: NAMES ONLY. Copy to .env (git-ignored), fill in,
# chmod 600. Used by compose.yaml (--env-file / env_file) and, for the systemd units,
# as the EnvironmentFile (write plain KEY=value lines: no quotes, no `export`).
# Real values and the real config live in measured-ops-private, never in this repo.

# --- Model and search keys
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
# Optional tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=proofline

# --- Inbox sign-in (docs/INBOX.md section 1)
MEASURED_OPS_INBOX_PASSPHRASE_HASH=
MEASURED_OPS_INBOX_SESSION_SECRET=

# --- Database (compose only; use a hex password: openssl rand -hex 24)
POSTGRES_PASSWORD=
# systemd/Ubuntu option: set these two yourself (postgresql://user:pass@127.0.0.1:5432/db)
# MEASURED_OPS_INBOX_CHECKPOINTER_URL=
# MEASURED_OPS_LOGS_URL=

# --- Real config files (paths as seen by the process; compose mounts ./private at /config)
MEASURED_OPS_TOOLS_CONFIG=/config/tools.toml
MEASURED_OPS_POLICY_PATH=/config/approval_policy.toml
MEASURED_OPS_PRICES_PATH=/config/model_prices.toml
MEASURED_OPS_BUDGET_PATH=/config/budget.toml
# Absolute path; compose.yaml sets /state/kill_switch itself
# MEASURED_OPS_KILL_SWITCH_PATH=

# --- Tool credentials (config/tools.toml names these; docs/TOOLS_SETUP.md in measured-ops-private)
ATLASSIAN_MCP_AUTH_HEADER=
OUTLOOK_MCP_CLIENT_ID=
OUTLOOK_MCP_TOOLSETS=calendar

# --- Tailscale (compose only)
TS_AUTHKEY=
TS_HOSTNAME=measured-ops
